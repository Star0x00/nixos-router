#!/usr/bin/bash
# Create a human login account. Not run at build or boot time - invoke manually.
#
#   router-adduser cyrene
#
# /home is a symlink to /var/home on bootc, so accounts and their data survive
# OS upgrades (only /etc and /var are writable; / is read-only).
set -euo pipefail

user="${1:?usage: router-adduser <username> [ssh-key-file]}"
keyfile="${2:-/etc/ssh/authorized_keys/root}"

if id -u "$user" >/dev/null 2>&1; then
    echo "user $user already exists" >&2
else
    useradd -m -G wheel -s /bin/bash "$user"
    echo "created $user"
fi

# Reuse the root key unless the account already has its own.
install -d -m 0700 -o "$user" -g "$user" "/var/home/$user/.ssh"
if [ ! -s "/var/home/$user/.ssh/authorized_keys" ] && [ -s "$keyfile" ]; then
    install -m 0600 -o "$user" -g "$user" "$keyfile" "/var/home/$user/.ssh/authorized_keys"
    echo "installed SSH key from $keyfile"
fi

echo "if you need console login: passwd $user"
