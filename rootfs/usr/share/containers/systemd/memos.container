[Unit]
Description=Memos 备忘录（原 NixOS 原生部署，这里改为容器，Fedora 无 RPM）

[Container]
Image=docker.io/neosmemo/memos:stable
ContainerName=memos
PublishPort=10.10.10.1:5230:5230
Volume=/var/lib/memos:/var/opt/memos:Z
Environment=MEMOS_DRIVER=sqlite
Environment=MEMOS_PORT=5230
Environment=MEMOS_ADDR=0.0.0.0

[Service]
Restart=always
After=network-online.target
Wants=network-online.target

[Install]
WantedBy=multi-user.target
