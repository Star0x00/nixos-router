[Unit]
Description=Sub-Store subscription manager
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/xream/sub-store:http-meta
ContainerName=sub-store
PublishPort=3001:3001
Volume=/var/lib/sub-store:/opt/app/data:Z
Environment=SUB_STORE_FRONTEND_BACKEND_PATH=/qwerhyy123
# The built-in frontend runs on the LAN address, so its own origin has to be
# allowed; without this every browser POST is rejected with
# "403 Forbidden: CORS origin not allowed" (defaults only allow the hosted UI).
Environment=SUB_STORE_CORS_ALLOWED_ORIGINS=http://10.10.10.1:3001
Environment="SUB_STORE_BACKEND_SYNC_CRON=55 23 * * *"
Environment="SUB_STORE_BACKEND_UPLOAD_CRON=0 4 * * *"
Environment=TZ=Asia/Shanghai

[Service]
Restart=always

[Install]
WantedBy=multi-user.target
