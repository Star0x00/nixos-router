dns {
  upstream {
    alidns: 'https://223.5.5.5/dns-query'
    cfdns: 'https://1.1.1.1/dns-query'
    googledns: 'https://8.8.8.8/dns-query'
  }
  routing {
    request {
      # Drop HTTPS/SVCB records (qtype 65): they carry ECH, so clients send an
      # encrypted ClientHello, dae cannot sniff the SNI, and domain-based
      # routing breaks. Clients fall back to A/AAAA queries.
      qtype(https) -> reject

      # Ad blocking: reject known ad domains.
      qname(geosite:category-ads-all) -> reject
      # Chinese domains resolve through alidns directly.
      qname(geosite:cn) -> alidns
      # Everything else also goes to alidns (it supports ECS, so overseas CDNs
      # still return a nearby node). Poisoned answers are re-queried via cfdns
      # by the response routing below.
      fallback: alidns
    }
    response {
      upstream(cfdns) -> accept
      upstream(googledns) -> accept
      # A non-Chinese name resolving to a private IP means DNS poisoning:
      # ask cfdns again.
      !qname(geosite:cn) && ip(geoip:private) -> cfdns
      fallback: accept
    }
  }
}
