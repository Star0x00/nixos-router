# 节点组(策略)。
#
# 对应原 singbox-a-base.json 里的 urltest 组, 现在由 dae 自己按延迟选节点:
#   cloudflare  ≈ 🚀 Cloudflare(同时也是 final / 通用代理)
#   google      ≈ 🚀 Google(用 gstatic 探活)
#   japan       ≈ 🇯🇵 日本
#
# 原来的 A/B 两路(socks5 127.0.0.1:2080 / 2081)已合并为同一份订阅,
# 所以不再用 sip() 按来源分流, 全部走这里的组。
group {
    # 通用代理: 主订阅(sub_a)内节点, 按延迟自动选。
    # 注意: dae 的 && 是逐节点「与」, 所以多个 name(keyword:) 用 && 会变成
    # 「名字同时含多个关键词」, 几乎必然为空; 要「或」请用 || 或 name(kw1, kw2)。
    cloudflare {
        filter: subtag(sub_a) && name(keyword: '日本') && name(keyword: 'IEPL')
        filter: subtag(sub_a) && name(keyword: '香港') && name(keyword: 'IEPL')
        policy: min_moving_avg
    }

    # Google 系: 用 gstatic 探活(和 sing-box 的 Google 一致)。
    google {
        filter: subtag(sub_a) && name(keyword: '日本') && name(keyword: 'IEPL')
        filter: subtag(sub_a) && name(keyword: '香港') && name(keyword: 'IEPL')
        tcp_check_url: 'http://www.gstatic.com/generate_204'
        policy: min_moving_avg
    }

    # 日本系: 只取节点名里带「日本」的节点。
    japan {
        filter: subtag(sub_a) && name(keyword: '日本')
        policy: min_moving_avg
    }

    # 大流量下载专用: 只用 lxy 订阅的节点, 与主订阅(sub_a)隔离。
    # docker/ghcr/包管理器等大文件下载走这条线, 省主订阅 IEPL 的流量。
    # lxy 订阅里混有「剩余流量/套餐到期」两行非节点文本, dae 会自动丢弃;
    # 这里再用 !name 排一次只为少刷告警。
    lxy {
        filter: subtag(sub_lxy) && !name(keyword: '剩余') && !name(keyword: '到期')
        policy: min_moving_avg
    }
}
