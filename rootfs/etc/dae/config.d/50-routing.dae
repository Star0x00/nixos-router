routing {
    # ── 基础设施直连(避免回环) ──
    # sing-box 的出站流量不能被 dae 再抓一次, 否则回环到自己
    pname(sing-box) -> must_direct
    pname(aardvark-dns) -> must_direct
    pname(systemd-networkd, NetworkManager) -> must_direct
    pname(conmon, netavark) -> must_direct
    pname(containerd, dockerd) -> must_direct

    # ── DNS ──
    l4proto(udp, tcp) && dport(53) -> direct

    # ── 容器网段直连(容器间通信 + 容器→宿主机不走代理) ──
    dip(10.88.0.0/16) -> direct
    dip(10.89.0.0/24) -> direct

    # ── 直连: 中国服务 ──
    domain(keyword: hdslb) -> must_direct
    domain(suffix: hdslb.com) -> must_direct
    domain(suffix: mmstat.com) -> direct
    domain(suffix: qianwenai.com) -> direct
    domain(suffix: hypergryph.com) -> direct
    domain(geosite:cn) -> direct
    domain(geosite:bilibili) -> must_direct
    domain(geosite:bilibili2) -> must_direct
    domain(geosite:bilibili-cdn) -> must_direct
    domain(geosite:bilibili-game) -> must_direct
    domain(geosite:netease) -> direct
    domain(geosite:steam) -> direct
    domain(geosite:aliyun) -> direct
    domain(geosite:alibaba) -> direct
    domain(geosite:aligames) -> direct
    domain(geosite:alibabacloud) -> direct
    domain(geosite:tencent) -> direct
    domain(geosite:tencent-dev) -> direct
    domain(geosite:tencent-tme) -> direct
    domain(geosite:tencent-games) -> direct
    domain(geosite:volcengine) -> direct
    domain(geosite:category-education-cn) -> direct
    domain(geosite:category-media-cn) -> direct
    domain(geosite:category-games-cn) -> direct
    domain(geosite:category-entertainment-cn) -> direct
    domain(geosite:category-bank-cn) -> direct
    domain(geosite:category-netdisk-cn) -> direct
    domain(geosite:category-social-media-cn) -> direct
    domain(geosite:category-scholar-cn) -> direct
    domain(geosite:category-dev-cn) -> direct
    domain(geosite:category-ai-cn) -> direct
    domain(geosite:category-ntp-cn) -> direct

    # ── 代理: 非中国互联网服务(全部走同一个 proxy 组) ──
    domain(geosite:category-ai-!cn, geosite:category-ai-chat-!cn,
           geosite:category-social-media-!cn, geosite:category-media,
           geosite:category-communication,
           geosite:category-dev, geosite:category-games-!cn,
           geosite:category-cryptocurrency, geosite:category-entertainment,
           geosite:category-anticensorship, geosite:category-scholar-!cn,
           geosite:category-browser-!cn, geosite:category-remote-control,
           geosite:category-proxy-tunnels, geosite:category-pt) -> proxy

    domain(geosite:category-porn) -> block

    # ── 按 IP 直连 ──
    dip(224.0.0.0/3, 'ff00::/8') -> direct
    dip(geoip:private) -> direct
    dip(geoip:cn) -> direct

    # ── 禁 QUIC ──
    l4proto(udp) && dport(443) -> block

    # ── UDP 全部直连(SOCKS5 接不住 UDP) ──
    l4proto(udp) -> direct

    # ── 其余 TCP 走代理 ──
    fallback: proxy
}
