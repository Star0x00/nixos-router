# dae 入口配置 —— 只负责 include。
#
# 具体内容按主题拆分在 config.d/ 下, 文件名前缀决定加载顺序:
#   10-global.dae        全局参数 / 网卡 / 探活
#   20-subscription.dae  Sub-Store 订阅(节点池)
#   30-dns.dae           DNS 上游与分流
#   40-group.dae         节点组(策略)
#   50-routing.dae       路由规则
#
# 注意: dae 要求被 include 的文件位于本入口文件所在目录之下, 所以用相对路径。
# 运行时入口是 /etc/dae/config.dae(NixOS 写入), 分片由 dae.nix 放到
# /etc/dae/config.d/ 下。

include {
    config.d/*.dae
}
