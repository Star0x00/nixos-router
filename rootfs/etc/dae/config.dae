# dae entry config - includes only.
#
# Topics are split under config.d/; the numeric prefix sets load order:
#   10-global.dae       global / interfaces / health check
#   20-subscription.dae Sub-Store subscription (node pool)
#   30-dns.dae          DNS upstreams and routing
#   40-group.dae        node groups (policies)
#   50-routing.dae      routing rules
#
# dae requires included files to live below the entry file's directory,
# hence the relative path. Runtime entry point is /etc/dae/config.dae.

include {
    config.d/*.dae
}
