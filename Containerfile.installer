# router-installer
#
# Anaconda environment used to build the installable ISO:
#
#   sudo image-builder build bootc-installer \
#     --bootc-ref localhost/router-installer:latest \
#     --bootc-installer-payload-ref ghcr.io/<owner>/router-bootc:latest \
#     --bootc-default-fs xfs \
#     --output-dir ./out
#
# The payload (localhost/router-bootc) is embedded into the ISO from the host's
# rootful containers-storage, so the install itself needs no network. The image
# type generates its own kickstart and grub entries; nothing here configures
# them. See https://osbuild.org/docs/developer-guide/projects/image-builder/advanced/bootc/isos/
FROM quay.io/fedora/fedora-bootc:44

# ── anaconda runtime + the build tools image-builder requires ──
# osbuild runs its stage scripts inside this container's /usr (pipeline.py picks
# the "build" pipeline tree as the stage buildroot), so tools the stages shell
# out to must be installed *here*, not on the host:
#   xorrisofs/implantisomd5  -> bootiso assembly
#   mako + lorax templates   -> org.osbuild.lorax-script
RUN dnf install -y --setopt=install_weak_deps=False \
        anaconda anaconda-install-img-deps anaconda-dracut \
        dracut-config-generic dracut-network net-tools \
        grub2-efi-x64-cdboot plymouth \
        default-fonts-core-sans default-fonts-other-sans google-noto-sans-cjk-fonts \
    && dnf install -y --setopt=install_weak_deps=False \
        xorrisofs squashfs-tools isomd5sum python3-mako lorax-templates-generic \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/cache/libdnf5

# ── contract: shim + grub EFI binaries under /boot/efi/EFI/$VENDOR ──
RUN mkdir -p /boot/efi && cp -ra /usr/lib/efi/*/*/EFI /boot/efi

# ── lorax emulation: NOT done here ──
# The bootc-installer image type injects anaconda-tree stages `org.osbuild.users`
# (creates the `install` user, unlocks root) and `org.osbuild.lorax-script`
# (runs lorax-templates-generic's runtime-postinstall.tmpl on the tree), which
# already does the list-harddrives/repos-dir/default.target/gpt-auto-generator/
# autovt/logind work that the generic-iso docs do by hand. Doing any of it here
# collides: the template's `move usr/share/anaconda/list-harddrives-stub ...` and
# `move etc/yum.repos.d etc/anaconda.repos.d` are plain os.rename() and fail if
# the source is gone.

# ── /var/mnt must exist ──
# fedora-bootc ships /mnt -> var/mnt and /srv -> var/srv as dangling symlinks;
# lorax's runtime-postinstall.tmpl does `symlink ../run/install mnt/install`, and
# os.symlink() needs the parent dir, so it dies with ENOENT without /var/mnt.
RUN mkdir -p /var/mnt

# ── install config, same as the payload's rootfs/usr/lib/bootc/install ──
RUN mkdir -p /usr/lib/bootc/install \
    && printf '[install.filesystem.root]\ntype = "xfs"\n' > /usr/lib/bootc/install/00-router.toml

RUN bootc container lint
