{
  "log": {
    "disabled": false,
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-resolver",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m"
  },
  "endpoints": [],
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen_port": 2080,
      "listen": "127.0.0.1"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🎯 Direct",
      "interrupt_exist_connections": true,
      "outbounds": [
        "direct",
        "block"
      ]
    },
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 Google",
        "🚀 Cloudflare",
        "🇭🇰 香港",
        "🇯🇵 日本",
        "🇸🇬 新加坡"
      ]
    },
    {
      "type": "selector",
      "tag": "🇭🇰 香港",
      "interrupt_exist_connections": true,
      "outbounds": [
        "香港A02 | IEPL",
        "香港A03 | IEPL",
        "香港A04 | IEPL",
        "香港A05 | IEPL"
      ]
    },
    {
      "type": "selector",
      "tag": "🇸🇬 新加坡",
      "interrupt_exist_connections": true,
      "outbounds": [
        "新加坡A01 | IEPL | x2",
        "新加坡A02 | IEPL | x2",
        "新加坡A03 | IEPL | x2"
      ]
    },
    {
      "type": "selector",
      "tag": "🇯🇵 日本",
      "interrupt_exist_connections": true,
      "outbounds": [
        "日本A01 | IEPL",
        "日本A02 | IEPL",
        "日本A03 | IEPL",
        "日本A04 | IEPL",
        "日本A07 | IEPL",
        "日本A08 | IEPL",
        "日本A09 | IEPL",
        "日本A10 | IEPL",
        "日本A11 | IEPL"
      ]
    },
    {
      "type": "urltest",
      "tag": "🚀 Google",
      "interrupt_exist_connections": true,
      "outbounds": [
        "香港A02 | IEPL",
        "香港A03 | IEPL",
        "香港A04 | IEPL",
        "香港A05 | IEPL",
        "日本A01 | IEPL",
        "日本A02 | IEPL",
        "日本A03 | IEPL",
        "日本A04 | IEPL",
        "日本A07 | IEPL",
        "日本A08 | IEPL",
        "日本A09 | IEPL",
        "日本A10 | IEPL",
        "日本A11 | IEPL"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🚀 Cloudflare",
      "interrupt_exist_connections": true,
      "outbounds": [
        "香港A02 | IEPL",
        "香港A03 | IEPL",
        "香港A04 | IEPL",
        "香港A05 | IEPL",
        "日本A01 | IEPL",
        "日本A02 | IEPL",
        "日本A03 | IEPL",
        "日本A04 | IEPL",
        "日本A07 | IEPL",
        "日本A08 | IEPL",
        "日本A09 | IEPL",
        "日本A10 | IEPL",
        "日本A11 | IEPL"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "selector",
      "tag": "🇺🇸 美国",
      "interrupt_exist_connections": true,
      "outbounds": [
        "block"
      ]
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "default_domain_resolver": "dns-resolver",
    "default_mark": 1234,
    "rules": [
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "direct",
