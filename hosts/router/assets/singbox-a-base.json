{
  "log": {
    "disabled": false,
    "level": "warn",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "type": "https",
        "tag": "dns-resolver",
        "server": "223.5.5.5",
        "server_port": 443,
        "path": "/dns-query"
      }
    ],
    "strategy": "prefer_ipv4"
  },
  "ntp": {
    "enabled": true,
    "server": "ntp.aliyun.com",
    "server_port": 123,
    "interval": "30m"
  },
  "http_clients": [
    {
      "tag": "ruleset-dl",
      "detour": "🇭🇰 香港"
    }
  ],
  "endpoints": [],
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen_port": 2080,
      "listen": "127.0.0.1"
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "🎯 Direct",
      "interrupt_exist_connections": true,
      "outbounds": [
        "direct",
        "block"
      ]
    },
    {
      "type": "selector",
      "tag": "🚀 节点选择",
      "interrupt_exist_connections": true,
      "outbounds": [
        "🚀 Google",
        "🚀 Cloudflare",
        "🇭🇰 香港",
        "🇸🇬 新加坡",
        "🇯🇵 日本",
        "🇺🇸 美国"
      ]
    },
    {
      "type": "urltest",
      "tag": "🇭🇰 香港",
      "interrupt_exist_connections": true,
      "outbounds": [
        "香港A02 | IEPL",
        "香港A03 | IEPL",
        "香港A04 | IEPL",
        "香港A05 | IEPL"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🇸🇬 新加坡",
      "interrupt_exist_connections": true,
      "outbounds": [
        "新加坡A01 | IEPL | x2",
        "新加坡A02 | IEPL | x2",
        "新加坡A03 | IEPL | x2"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🇯🇵 日本",
      "interrupt_exist_connections": true,
      "outbounds": [
        "日本A01 | IEPL",
        "日本A02 | IEPL",
        "日本A03 | IEPL",
        "日本A04 | IEPL",
        "日本A07 | IEPL",
        "日本A08 | IEPL",
        "日本A09 | IEPL",
        "日本A10 | IEPL",
        "日本A11 | IEPL"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🇺🇸 美国",
      "interrupt_exist_connections": true,
      "outbounds": [
        "美国A01 | IEPL | x1.5",
        "美国A02 | IEPL | x1.5"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🚀 Google",
      "interrupt_exist_connections": true,
      "outbounds": [
        "香港A02 | IEPL",
        "香港A03 | IEPL",
        "香港A04 | IEPL",
        "香港A05 | IEPL",
        "新加坡A01 | IEPL | x2",
        "新加坡A02 | IEPL | x2",
        "新加坡A03 | IEPL | x2",
        "日本A01 | IEPL",
        "日本A02 | IEPL",
        "日本A03 | IEPL",
        "日本A04 | IEPL",
        "日本A07 | IEPL",
        "日本A08 | IEPL",
        "日本A09 | IEPL",
        "日本A10 | IEPL",
        "日本A11 | IEPL",
        "美国A01 | IEPL | x1.5",
        "美国A02 | IEPL | x1.5"
      ],
      "url": "https://www.gstatic.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "urltest",
      "tag": "🚀 Cloudflare",
      "interrupt_exist_connections": true,
      "outbounds": [
        "香港A02 | IEPL",
        "香港A03 | IEPL",
        "香港A04 | IEPL",
        "香港A05 | IEPL",
        "新加坡A01 | IEPL | x2",
        "新加坡A02 | IEPL | x2",
        "新加坡A03 | IEPL | x2",
        "日本A01 | IEPL",
        "日本A02 | IEPL",
        "日本A03 | IEPL",
        "日本A04 | IEPL",
        "日本A07 | IEPL",
        "日本A08 | IEPL",
        "日本A09 | IEPL",
        "日本A10 | IEPL",
        "日本A11 | IEPL",
        "美国A01 | IEPL | x1.5",
        "美国A02 | IEPL | x1.5"
      ],
      "url": "https://cp.cloudflare.com/generate_204",
      "interval": "1m",
      "tolerance": 50
    },
    {
      "type": "direct",
      "tag": "direct"
    },
    {
      "type": "block",
      "tag": "block"
    }
  ],
  "route": {
    "default_domain_resolver": "dns-resolver",
    "default_mark": 1234,
    "default_http_client": "ruleset-dl",
    "rules": [
      {
        "ip_cidr": [
          "223.5.5.5/32"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "action": "sniff"
      },
      {
        "ip_is_private": true,
        "action": "route",
        "outbound": "direct"
      },
      {
        "clash_mode": "direct",
        "action": "route",
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "bilibili.com",
          "bilibili.tv",
          "bilicdn.com"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "domain_suffix": [
          "edu.cn"
        ],
        "action": "route",
        "outbound": "🎯 Direct"
      },
      {
        "domain_suffix": [
          "gstatic.com"
        ],
        "action": "route",
        "outbound": "🚀 Google"
      },
      {
        "domain_suffix": [
          "github.com",
          "githubusercontent.com"
        ],
        "action": "route",
        "outbound": "🚀 Cloudflare"
      },
      {
        "domain_suffix": [
          "fedoraforum.org",
          "fedorainfracloud.org",
          "fedoramagazine.org",
          "fedorapeople.org",
          "fedoraproject.org",
          "getfedora.org"
        ],
        "action": "route",
        "outbound": "🚀 Cloudflare"
      },
      {
        "rule_set": [
          "meta"
        ],
        "action": "route",
        "outbound": "🇯🇵 日本"
      },
      {
        "domain": [
          "opencode.ai",
          "meta.ai"
        ],
        "action": "route",
        "outbound": "🇯🇵 日本"
      },
      {
        "rule_set": [
          "bilibili",
          "bilibili2",
          "bilibili-cdn"
        ],
        "action": "route",
        "outbound": "direct"
      },
      {
        "rule_set": [
          "tencent",
          "aliyun",
          "tencent-games",
          "category-education-cn",
          "volcengine"
        ],
        "action": "route",
        "outbound": "🎯 Direct"
      },
      {
        "rule_set": [
          "google",
          "youtube",
          "google-deepmind",
          "google-gemini",
          "googlefcm",
          "android"
        ],
        "action": "route",
        "outbound": "🚀 Google"
      },
      {
        "rule_set": [
          "Openai"
        ],
        "action": "route",
        "outbound": "🚀 Google"
      },
      {
        "rule_set": [
          "Github"
        ],
        "action": "route",
        "outbound": "🚀 Cloudflare"
      },
      {
        "rule_set": [
          "CN"
        ],
        "action": "route",
        "outbound": "🎯 Direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "volcengine",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-volcengine.srs"
      },
      {
        "type": "remote",
        "tag": "meta",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-meta.srs"
      },
      {
        "type": "remote",
        "tag": "bilibili",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-bilibili.srs"
      },
      {
        "type": "remote",
        "tag": "bilibili2",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-bilibili2.srs"
      },
      {
