      {
        "type": "remote",
        "tag": "android",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-android.srs"
      }
    ],
    "final": "🚀 Cloudflare",
    "auto_detect_interface": true
  },
  "services": [
    {
      "type": "api",
      "listen": "0.0.0.0",
      "listen_port": 9090,
      "dashboard": {
        "enabled": true
      }
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "path": "cache.db",
      "store_dns": true
    }
  }
}
