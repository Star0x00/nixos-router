        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-google-gemini.srs"
      },
      {
        "type": "remote",
        "tag": "Openai",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-openai.srs"
      },
      {
        "type": "remote",
        "tag": "google",
        "format": "binary",
        "url": "https://cdn.jsdelivr.net/gh/SagerNet/sing-geosite@rule-set/geosite-google.srs"
      },
      {
        "type": "remote",
        "tag": "youtube",
        "format": "binary",
